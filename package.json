{
  "name": "kufic-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "golden": "UPDATE_GOLDEN=1 vitest run tests/golden-update.test.ts",
    "golden:lab": "node scripts/golden-lab.mjs",
    "compare:lab": "node scripts/compare-lab.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "mosque": "MOSQUE=1 vitest run tests/mosque.test.ts",
    "showpiece": "SHOWPIECE=1 vitest run tests/showpiece.test.ts",
    "wedding": "WEDDING=1 vitest run tests/wedding.test.ts",
    "sweep": "SWEEP=1 vitest run tests/sweep.test.ts",
    "refit": "REFIT=1 vitest run tests/refit.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@countertype/clipper2-ts": "^1.5.4",
    "clipper2-wasm": "0.4.0",
    "polylabel": "^2.1.0",
    "zod": "^4.6.6"
  }
}
